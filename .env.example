# Copie este arquivo para .env (ou exporte as variaveis diretamente no shell)
# e preencha com valores reais. NUNCA commite o .env preenchido.

# Chave da API do Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# URL base da API de estados brasileiros
ESTADO_API_BASE_URL=

# Chave exigida no header X-API-Key para chamar POST /ask
ASK_API_KEY=
