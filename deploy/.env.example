# Copiar para ~/estado-ai-agent/.env na instancia (chmod 600) e preencher com
# valores reais. O .env real NUNCA vai pro repo - segredo fica so na
# instancia e no Bitwarden (mesmo padrao do repo estado, ver deploy/README.md
# la).

# Chave da API do Gemini (Google AI Studio).
GEMINI_API_KEY=changeme-gemini-api-key

# Autenticacao do backend estado (BFF) perante este app - precisa bater com
# ASK_API_KEY no .env do backend estado (ver deploy/estado/.env.example la).
# Nao e mais consumida por nenhum frontend diretamente - o ai-agent nao e
# publicamente alcancavel (ver docker-compose.yml aqui: sem rede
# "portfolio"/Caddy).
ASK_API_KEY=changeme-segredo-aleatorio-longo

# Rate limit por IP em /ask (ver RateLimitFilter) - opcional, default 10
# requisicoes por janela de 1 minuto.
# ASK_RATE_LIMIT_CAPACITY=10
# ASK_RATE_LIMIT_WINDOW_MINUTES=1
